# Milestone 1.1: no credentials or external services are required.
APP_NAME=AI Incident Copilot
APP_ENV=development
DEBUG=false

# Retained earlier database setup; unused by app.main in Milestone 1.1.
# Set a local password and use the same value in DATABASE_URL (URL-encode it).
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=
POSTGRES_DB=incident_db
POSTGRES_PORT=5432
# postgresql+psycopg://incident_user:YOUR_PASSWORD@localhost:5432/incident_db
DATABASE_URL=
# LLM settings are unused until Day 6.
OPENAI_API_KEY=
OPENAI_MODEL=
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=5
