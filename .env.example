# Milestone 1.2: PostgreSQL is required at application startup.
APP_NAME=AI Incident Copilot
APP_ENV=development
DEBUG=false
# Milestone 2.2: generate a private random signing key; never commit the real value.
JWT_SECRET_KEY=
JWT_ISSUER=incident-copilot
JWT_AUDIENCE=incident-copilot-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Opt in locally; default is disabled when this setting is absent.
ALLOW_REGISTRATION=false

# FastAPI runs in WSL; PostgreSQL runs in Docker Compose.
# Set a local password and use the same value in DATABASE_URL (URL-encode it).
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=
POSTGRES_DB=incident_db
POSTGRES_PORT=5433
# postgresql+psycopg://incident_user:YOUR_PASSWORD@localhost:5433/incident_db
DATABASE_URL=
# Milestone 1.6: needed only when selected evidence requires an LLM call.
# Prefer LLM_MODEL; OPENAI_MODEL is retained as a compatibility fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_INCIDENT=10
MAX_EVIDENCE_ITEMS=30
