# Milestone 1.2: PostgreSQL is required at application startup.
APP_NAME=AI Incident Copilot
APP_ENV=development
DEBUG=false

# FastAPI runs in WSL; PostgreSQL runs in Docker Compose.
# Set a local password and use the same value in DATABASE_URL (URL-encode it).
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=
POSTGRES_DB=incident_db
POSTGRES_PORT=5433
# postgresql+psycopg://incident_user:YOUR_PASSWORD@localhost:5433/incident_db
DATABASE_URL=
# LLM settings are unused in this milestone.
OPENAI_API_KEY=
OPENAI_MODEL=
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_EVIDENCE_ITEMS=30
